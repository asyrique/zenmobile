<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- An AutoFill provider for passwords. -->
    <key>com.apple.developer.authentication-services.autofill-credential-provider</key>
    <true/>
    <!-- The app's logins database lives in the shared container... -->
    <key>com.apple.security.application-groups</key>
    <array>
        <string>group.io.github.asyrique.zenmobile</string>
    </array>
    <!-- ...and its key in the shared Keychain group. -->
    <key>keychain-access-groups</key>
    <array>
        <string>$(AppIdentifierPrefix)io.github.asyrique.zenmobile.shared</string>
    </array>
</dict>
</plist>
